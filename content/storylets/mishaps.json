[
  {"id":"ms-ceiling-leak","kind":"happening","trigger":"hour","cooldownDays":6,"when":{"weather":["rain"]},"roles":{"a":{"floor":1,"inRoom":true}},"texts":["{a}さんの天井から、雨水がぽたぽた落ちてきた。バケツを置いたら、リズムが気に入ってしまった","{a}さんの部屋の天井のシミが広がった。{a}さんはシミに名前をつけて、愛でている"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-5},{"type":"adjust","role":"a","stat":"comfort","delta":-8}]},
  {"id":"ms-power-flip","kind":"happening","trigger":"hour","cooldownDays":6,"roles":{"a":{"inRoom":true,"awake":true},"b":{"inRoom":true}},"texts":["{a}さんがドライヤーとこたつを同時に使い、ブレーカーが落ちた。廊下から「またか」と声が上がった","{a}さんがレンジとポットを一緒に動かして、アパートじゅうが暗くなった。{b}さんが懐中電灯で駆けつけた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-4},{"type":"bond","delta":-1}]},
  {"id":"ms-gas-smell","kind":"happening","trigger":"hour","cooldownDays":8,"when":{"hours":[6,22]},"roles":{"a":{"inRoom":true,"awake":true},"b":{"inRoom":true,"awake":true}},"texts":["{a}さんの部屋からガスのような匂いがして、{b}さんが窓を開けた。原因は、焦げたトースターだった","{a}さんが、ガスの元栓の閉め忘れで、あわてて部屋中の窓を開けた。{b}さんが「無事でよかった」と言った"],"effects":[{"type":"bond","delta":4},{"type":"adjust","role":"a","stat":"mood","delta":-5}]},
  {"id":"ms-toilet-clog","kind":"happening","trigger":"hour","cooldownDays":8,"roles":{"a":{}},"texts":["共用の便所が詰まった。{a}さんは静かに立ち去り、犯人は今も分かっていない","共用の便所が詰まって、{a}さんが最初の発見者になった。ラバーカップは、{a}さんが握った"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-4}]},
  {"id":"ms-stuck-door","kind":"happening","trigger":"hour","cooldownDays":8,"when":{"weather":["rain"]},"roles":{"a":{"inRoom":true},"b":{"awake":true}},"texts":["{a}さんの部屋のドアが、雨で膨らんで開かなくなった。{b}さんが外から体当たりし、二人して転がった","{a}さんがドアの前で、五分格闘した。{b}さんが通りかかって、蝶番を外側から叩いたら開いた"],"effects":[{"type":"bond","delta":4},{"type":"adjust","role":"a","stat":"mood","delta":-3}]},
