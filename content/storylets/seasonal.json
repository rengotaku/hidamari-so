  {"id":"wi-cold-bath","kind":"daily","trigger":"hour","cooldownDays":4,"weight":2,"when":{"hours":[17,23],"season":["winter"]},"roles":{"a":{"out":true}},"texts":["銭湯の帰り道、{a}さんの髪が凍った。本人は風呂上がりの最高の状態を維持したつもりだった","{a}さんは、湯冷めしないようにと走って帰った。着いた部屋のほうが、外より寒かった"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-3}]},
