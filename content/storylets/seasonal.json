  {"id":"wi-static","kind":"daily","trigger":"hour","cooldownDays":4,"when":{"season":["winter"]},"roles":{"a":{}},"texts":["{a}さんが冷たいドアノブに触れて、パチッと鳴った。手を引っ込めたのは、三回目からだった","{a}さんのセーターが静電気を起こす。壁を触るたび、自分で驚いている"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-2}]},
