[
  {"id":"wh-notice","kind":"relation","trigger":"hour","cooldownDays":16,"chance":0.6,"roles":{"a":{"inRoom":true,"awake":true},"b":{"inRoom":true}},"texts":["{a}さんが壁の隅に小さな穴を見つけた。向こうから、{b}さんの部屋の灯りが細く漏れている","{a}さんの壁に、指が入るくらいの穴があった。のぞいた先で、{b}さんの机が見えた"],"effects":[{"type":"book","next":[{"id":"wh-notes"}],"afterMinutes":[1440,4320]}]},
  {"id":"wh-notes","kind":"relation","trigger":"book","when":{"hours":[9,24]},"roles":{"a":{"inRoom":true},"b":{"inRoom":true}},"texts":["壁の穴に、小さな紙が通された。{a}さんが開くと「夜はもう少し静かに」。返事に「善処する」と書いて押し返した","{b}さんからの貼り紙が穴から届いた。内容は「壁が薄いので、おたがいさまです」。{a}さんは笑って、字を真似て返した"],"effects":[{"type":"bond","delta":3},{"type":"book","next":[{"id":"wh-hatch"}],"afterMinutes":[2880,7200]}]},
  {"id":"wh-hatch","kind":"relation","trigger":"book","when":{"hours":[18,24]},"roles":{"a":{"inRoom":true},"b":{"inRoom":true}},"texts":["{a}さんと{b}さんの壁の穴は、いつしか夜食と手紙の受け渡し口になっていた","穴ごしに、{b}さんから煮物が、{a}さんからは饅頭が、静かに行き来している。二人とも壁の向こうを見ようとはしない"],"effects":[{"type":"bond","delta":8},{"type":"adjust","role":"a","stat":"mood","delta":6},{"type":"adjust","role":"b","stat":"mood","delta":6},{"type":"book","next":[{"id":"wh-kept","weight":2},{"id":"wh-plugged","weight":1}],"afterMinutes":[4320,10080]}]},
  {"id":"wh-kept","kind":"relation","trigger":"book","roles":{"a":{},"b":{}},"texts":["穴は、いつのまにか正式に「受け渡し口」と呼ばれるようになった。大家も、見て見ぬふりを続けている","{a}さんと{b}さんの穴に、誰かが小さな紙で枠を作った。穴は、堂々とそこにある"],"effects":[{"type":"bond","delta":5},{"type":"adjust","role":"a","stat":"mood","delta":5},{"type":"adjust","role":"b","stat":"mood","delta":5}]},
  {"id":"wh-plugged","kind":"relation","trigger":"book","roles":{"a":{"inRoom":true},"b":{"inRoom":true}},"texts":["大家が穴に気づいて、紙で塞いだ。紙の隅に、誰かが「ありがとう」と書き足していた","{a}さんと{b}さんの穴が、修理で塞がれた。二人は、その壁に順番に手を当てて、何も言わなかった"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-6},{"type":"adjust","role":"b","stat":"mood","delta":-6}]},
  {"id":"hn-plan","kind":"relation","trigger":"hour","cooldownDays":16,"chance":0.7,"weight":4,"when":{"hours":[9,18],"season":["spring"]},"roles":{"a":{"inRoom":true,"awake":true}},"texts":["{a}さんが花見の幹事を買って出た。場所取りの日程を、三回変更した","花見の季節。{a}さんは、「今年こそ全員で」と言って、参加者のリストを作った。リストは二行だった"],"effects":[{"type":"book","next":[{"id":"hn-spot"}],"afterMinutes":[1440,2880]}]},
  {"id":"hn-spot","kind":"relation","trigger":"book","when":{"hours":[5,12]},"roles":{"a":{}},"texts":["{a}さんは、桜の下にシートを広げて場所取りをした。三時間経って、シートの下のアリが増えた","{a}さんが場所取りの朝、先客に場所を譲りかけた。迷った末、隅のほうに小さく陣取った"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-2},{"type":"book","next":[{"id":"hn-tea"}],"afterMinutes":[600,1800]}]},
  {"id":"hn-tea","kind":"relation","trigger":"book","when":{"hours":[11,17]},"roles":{"a":{}},"texts":["{a}さんの用意した酒は、大家の持ってきた薄い番茶だった。みんなはそれを酒だと信じて乾杯した","花見の酒は、名ばかりの薄い番茶。卵焼きは沢庵、蒲鉾は大根の香の物。{a}さんは、笑いをこらえて乾杯した"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":3},{"type":"book","next":[{"id":"hn-bento"}],"afterMinutes":[120,360]}]},
  {"id":"hn-bento","kind":"relation","trigger":"book","when":{"hours":[11,18]},"roles":{"a":{}},"texts":["花見の弁当は持ち寄りだった。{a}さんの玉子焼きだけが、なぜか全員の箸の先に集まった","持ち寄りの弁当が広がった。{a}さんの唐揚げは、ひとつ取るたびに誰かの溜息がついた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":5},{"type":"book","next":[{"id":"hn-rain","weight":1},{"id":"hn-drunk","weight":1}],"afterMinutes":[120,480]}]},
  {"id":"hn-rain","kind":"relation","trigger":"book","when":{"hours":[11,22]},"roles":{"a":{"inRoom":true}},"texts":["急に雨が降りだして、花見は{a}さんの部屋に移った。桜の枝を一本、窓辺に立てて続きを始めた","夕立で花見は一時中止。{a}さんの部屋に全員が集まり、窓から見える桜で続行した"],"effects":[{"type":"party","bond":8,"mood":8}]},
  {"id":"hn-drunk","kind":"relation","trigger":"book","when":{"hours":[14,24]},"roles":{"a":{}},"texts":["花見の帰り道、{a}さんだけがいつまでも桜の下に座り込んだ。誰が連れて帰るかで、ひと騒ぎになった","桜の下で寝込んだ{a}さんに、誰かが上着を一枚かけた。花びらが、布団のようだった"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":6},{"type":"adjust","role":"a","stat":"sleepy","delta":20}]},
  {"id":"gf-catch","kind":"relation","trigger":"hour","cooldownDays":16,"chance":0.6,"weight":4,"when":{"hours":[18,23],"season":["summer"]},"roles":{"a":{"out":true}},"texts":["{a}さんが縁日で金魚を三匹すくった。最後の一匹は、{a}さんが網を破いた後でおまけしてもらった","夏祭りの帰り、{a}さんのポリ袋の中に金魚が一匹泳いでいた。明日のことは、まだ考えていない"],"effects":[{"type":"book","next":[{"id":"gf-foster"}],"afterMinutes":[600,1800]}]},
  {"id":"gf-foster","kind":"relation","trigger":"book","when":{"hours":[9,22]},"roles":{"a":{},"b":{"inRoom":true}},"texts":["{a}さんは金魚を飼えず、{b}さんに預けた。{b}さんは最初断ったが、水槽の代わりの丼を貸してくれた","{a}さんの金魚が{b}さんの部屋に引っ越した。{b}さんの猫好きの面が、金魚の前で出てきた"],"effects":[{"type":"bond","delta":3},{"type":"book","next":[{"id":"gf-naming"}],"afterMinutes":[1440,2880]}]},
  {"id":"gf-naming","kind":"relation","trigger":"book","when":{"hours":[17,24]},"roles":{"a":{},"b":{}},"texts":["金魚の名前をめぐる会議は、三日続いた。候補は「ポチ」「キャビア」「課長」の三つだった","金魚の名前を決める会議で、{a}さんと{b}さんの意見が真っ二つに分かれた。結局、金魚が知らん顔で泳いでいた"],"effects":[{"type":"bond","delta":4},{"type":"adjust","role":"a","stat":"mood","delta":3},{"type":"adjust","role":"b","stat":"mood","delta":3},{"type":"book","next":[{"id":"gf-survive","weight":1},{"id":"gf-gone","weight":1}],"afterMinutes":[14400,28800]}]},
  {"id":"gf-survive","kind":"relation","trigger":"book","roles":{"a":{},"b":{}},"texts":["金魚は冬を越して、年が明けた。{a}さんと{b}さんは、朝の挨拶を金魚から始めている","金魚が、アパートのマスコットになった。{b}さんの丼は、いつのまにか立派な水槽に格上げされていた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":6},{"type":"adjust","role":"b","stat":"mood","delta":6},{"type":"bond","delta":4}]},
  {"id":"gf-gone","kind":"relation","trigger":"book","roles":{"a":{},"b":{}},"texts":["金魚が、ある朝、静かに動かなくなった。{b}さんと{a}さんは、庭の隅に小さな穴を掘った","金魚の水槽が、空になった。{b}さんは水を捨てながら、少しだけ長く丼を洗った"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-6},{"type":"adjust","role":"b","stat":"mood","delta":-6},{"type":"bond","delta":2}]},
  {"id":"cd-found","kind":"daily","trigger":"hour","cooldownDays":16,"chance":0.6,"weight":4,"when":{"hours":[9,17],"season":["winter"]},"roles":{"a":{"inRoom":true,"awake":true}},"texts":["{a}さんが押入れを掃除していたら、前の住人宛の年賀状の束が出てきた。宛名は、読めない達筆だった","大掃除で、{a}さんは押入れの奥から、前の住人のものらしい年賀状を見つけた。差出人は、丁寧な字を書く人だ"],"effects":[{"type":"book","next":[{"id":"cd-search"}],"afterMinutes":[1440,4320]}]},
  {"id":"cd-search","kind":"daily","trigger":"book","when":{"hours":[9,20]},"roles":{"a":{}},"texts":["{a}さんは、年賀状の宛先を探してみた。電話帳をめくり、近所で聞き込みをして、二日が過ぎた","{a}さんが年賀状の持ち主を探しはじめた。手がかりは、消印と、猫のイラストだけだった"],"effects":[{"type":"book","next":[{"id":"cd-delivered"}],"afterMinutes":[1440,4320]}]},
  {"id":"cd-delivered","kind":"relation","trigger":"book","when":{"hours":[10,20]},"roles":{"a":{},"b":{"awake":true}},"texts":["{b}さんが、年賀状の差出人を知っていた。{a}さんの預けた年賀状は、{b}さんの手で本人に届いた","年賀状は、{b}さんの古い知り合いに渡った。{a}さんは「届いたらしい」とだけ報告した"],"effects":[{"type":"bond","delta":4},{"type":"book","next":[{"id":"cd-reply","weight":1},{"id":"cd-silence","weight":1}],"afterMinutes":[4320,10080]}]},
  {"id":"cd-reply","kind":"relation","trigger":"book","when":{"hours":[10,18]},"roles":{"a":{},"b":{}},"texts":["年賀状の返事が、三年ぶりに届いた。{a}さんは、宛先を見て「あの人だ」と声に出した","{a}さんの元に、年賀状の返事が来た。「覚えていてくれてありがとう」と書いてあった"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":8},{"type":"adjust","role":"b","stat":"mood","delta":6},{"type":"bond","delta":4}]},
  {"id":"cd-silence","kind":"daily","trigger":"book","when":{"hours":[10,20]},"roles":{"a":{}},"texts":["年賀状の返事は来なかった。{a}さんは、束をそっと額に入れて飾ることにした","返事の来ない年賀状を、{a}さんは捨てなかった。額に入れて、壁に掛けた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-2}]},
  {"id":"dr-deadline","kind":"relation","trigger":"hour","cooldownDays":20,"chance":0.6,"weight":1.5,"when":{"hours":[20,24]},"roles":{"a":{"archetype":["band","mangaka","rakugo","youtuber","uranai"],"stayDays":{"min":8},"inRoom":true},"b":{"inRoom":true}},"texts":["{a}さんが、夢に期限を決めた。「次の春まで」と紙に書いて、壁に貼った","{a}さんは、夢のリミットを自分で決めた。貼り紙の字は、いつもより小さかった"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-2},{"type":"book","next":[{"id":"dr-rehearsal"}],"afterMinutes":[1440,4320]}]},
  {"id":"dr-rehearsal","kind":"relation","trigger":"book","logKind":"noise","when":{"hours":[18,24]},"roles":{"a":{"inRoom":true,"awake":true},"b":{"inRoom":true}},"texts":["{a}さんの稽古の音が、壁を越えてくる。{b}さんは、最初の苦情を口の中でつぶした","{a}さんが、期限に向けて毎晩稽古している。{b}さんは、いつのまにか曲の順番を覚えた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":5},{"type":"bond","delta":2},{"type":"book","next":[{"id":"dr-flyers"}],"afterMinutes":[2880,5760]}]},
  {"id":"dr-flyers","kind":"relation","trigger":"book","when":{"hours":[9,20]},"roles":{"a":{},"b":{"awake":true}},"texts":["{a}さんが、全室のドアにチラシを貼って回った。最後の一枚は、{b}さんに直接手渡した","最終公演のチラシが、全部屋のポストに入った。{a}さんの字は、ていねいだった"],"effects":[{"type":"bond","delta":3},{"type":"adjust","role":"a","stat":"mood","delta":4},{"type":"book","next":[{"id":"dr-audience"}],"afterMinutes":[2880,5760]}]},
  {"id":"dr-audience","kind":"relation","trigger":"book","when":{"hours":[17,23]},"roles":{"a":{"inRoom":true}},"texts":["{a}さんの最終公演に、アパートの全員が客席を埋めた。拍手の大きさに、{a}さんが一番驚いた顔をした","最後の舞台の日、客席は{a}さんの部屋だった。観客は全員住人で、拍手は全員の分だった"],"effects":[{"type":"party","bond":8,"mood":10},{"type":"book","next":[{"id":"dr-continue","weight":1},{"id":"dr-homebound","weight":1}],"afterMinutes":[1440,4320]}]},
  {"id":"dr-continue","kind":"relation","trigger":"book","roles":{"a":{}},"texts":["{a}さんは、期限を過ぎたあとも続けることにした。貼り紙は、こっそり剥がされていた","{a}さんが、最終公演のあとで言った。「あと一回だけ」。住人の誰も、驚かなかった"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":8},{"type":"say","role":"a","text":"もう少しだけ、やってみる"}]},
  {"id":"dr-homebound","kind":"relation","trigger":"book","logKind":"move","roles":{"a":{}},"texts":["{a}さんは、晴れやかな顔で荷造りをした。「やり切った」と、ドアの前で言った","{a}さんが、帰郷を決めた。駅までの道は、全員で並んで歩いた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":6},{"type":"moveOut","role":"a"}]}
