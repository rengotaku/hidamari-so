[
  {"id":"wk-konbini-expired","kind":"daily","trigger":"hour","cooldownDays":5,"when":{"hours":[6,10]},"roles":{"a":{"archetype":["konbini"],"out":false}},"texts":["{a}さんが、廃棄の弁当を持ち帰ってきた。賞味期限はぎりぎり今日で、朝まで冷蔵庫が幸せそうだった","夜勤明けの{a}さんが、袋いっぱいの廃棄弁当を廊下で配っていた。{a}さんは店長の目を盗んだ気でいる"],"effects":[{"type":"adjust","role":"a","stat":"hunger","delta":-25},{"type":"adjust","role":"a","stat":"mood","delta":3}]},
  {"id":"wk-konbini-customer","kind":"daily","trigger":"hour","cooldownDays":6,"when":{"hours":[0,6]},"roles":{"a":{"archetype":["konbini"],"out":true}},"texts":["{a}さんは、夜勤でおでんの汁を客にこぼされた。客は謝りもせず、{a}さんは笑顔を保った","夜勤中の{a}さんに、酔った客が一時間、人生相談をしてきた。{a}さんは最終的に励ます側に回った"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-4}]},
  {"id":"wk-band-practice-wall","kind":"relation","trigger":"hour","cooldownDays":4,"logKind":"noise","when":{"hours":[14,24]},"roles":{"a":{"archetype":["band"],"inRoom":true},"b":{"inRoom":true}},"texts":["{a}さんのギターが、同じフレーズを九十分繰り返している。{b}さんは、もう曲の続きまで聴こえる気がしてきた","{a}さんが、新曲のサビだけを夜通し練習している。{b}さんの頭の中でも、サビだけが流れ続けている"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":5},{"type":"adjust","role":"b","stat":"mood","delta":-3}]},
  {"id":"wk-band-live-ticket","kind":"relation","trigger":"hour","cooldownDays":8,"roles":{"a":{"archetype":["band"]},"b":{}},"texts":["{a}さんが、チケットを{b}さんに押しつけた。ライブの客は七人。そのうち三人が出演者の家族だ","{a}さんのライブに行った{b}さんが、帰りに缶のジュースをおごられた。出演料はそれで相殺らしい"],"effects":[{"type":"bond","delta":3},{"type":"adjust","role":"a","stat":"mood","delta":4}]},
  {"id":"wk-ronin-mock-exam","kind":"daily","trigger":"hour","cooldownDays":6,"when":{"hours":[14,20]},"roles":{"a":{"archetype":["ronin"],"inRoom":true}},"texts":["{a}さんが、模試の結果を見て黙った。ゴミ箱に捨てかけて、また拾って引き出しにしまった","{a}さんは、模試の判定欄を指でなぞった。「D」の字が、昨日より小さく見えた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-6}]},
  {"id":"wk-ronin-study-snack","kind":"relation","trigger":"hour","cooldownDays":6,"roles":{"a":{"archetype":["ronin"]},"b":{"awake":true}},"texts":["{b}さんが、勉強する{a}さんにおにぎりを届けた。{a}さんは、参考書の上に置いたまま三時間忘れた","{a}さんの机に、{b}さんからの差し入れの蜜柑が置いてあった。受験生はそれだけで一日がんばれる"],"effects":[{"type":"bond","delta":4},{"type":"adjust","role":"a","stat":"mood","delta":6}]},
  {"id":"wk-oldman-radio","kind":"daily","trigger":"hour","cooldownDays":4,"when":{"hours":[5,10]},"roles":{"a":{"archetype":["oldman"],"inRoom":true}},"texts":["{a}さんがラジオの野球中継を聴きながら、昔の車掌時代の話を独り言でしている。内容は全部同じだ","{a}さんが、朝のラジオ体操の号令に合わせて、最後まで動かなかった。耳だけが元気だった"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":3}]},
  {"id":"wk-oldman-walk-greeting","kind":"relation","trigger":"hour","cooldownDays":5,"when":{"hours":[5,9]},"roles":{"a":{"archetype":["oldman"],"out":true}},"texts":["朝の散歩の{a}さんが、近所の犬に毎朝挨拶をしている。犬は今日も無視した","{a}さんの朝の散歩で、商店街の店主全員に声をかけた。帰りは二時間遅れだった"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":4}]},
  {"id":"wk-salaryman-overtime","kind":"daily","trigger":"hour","cooldownDays":4,"when":{"hours":[23,24]},"roles":{"a":{"archetype":["salaryman"],"out":true}},"texts":["{a}さんが、終電に走った。ネクタイを手に、階段を三段ずつ飛ばして降りていく","{a}さんが、残業で帰ってきたのは日付が変わった後だった。上着を脱ぎ捨てて、靴のまま寝た"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-6},{"type":"adjust","role":"a","stat":"sleepy","delta":15}]},
  {"id":"wk-salaryman-golf","kind":"relation","trigger":"hour","cooldownDays":8,"when":{"hours":[5,9]},"roles":{"a":{"archetype":["salaryman"]},"b":{}},"texts":["{a}さんが接待ゴルフの自慢話をした。{b}さんは聞いたふりをして、三回あくびを噛み殺した","{a}さんが、休日の朝に接待ゴルフへ出かけていった。{b}さんはクラブの長さに驚いた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-2}]},
  {"id":"wk-mangaka-deadline","kind":"daily","trigger":"hour","cooldownDays":4,"when":{"hours":[0,6]},"roles":{"a":{"archetype":["mangaka"],"inRoom":true,"awake":true}},"texts":["{a}さんは締切が近いので、何も食べずにペンを握っている。締切は誰が決めたものでもない","{a}さんがベタ塗りを続けて、指が黒くなった。紙の白い部分が、まぶしく見えている"],"effects":[{"type":"adjust","role":"a","stat":"sleepy","delta":15},{"type":"adjust","role":"a","stat":"hunger","delta":15},{"type":"adjust","role":"a","stat":"mood","delta":-4}]},
  {"id":"wk-mangaka-editor","kind":"daily","trigger":"hour","cooldownDays":8,"when":{"hours":[12,20]},"roles":{"a":{"archetype":["mangaka"],"inRoom":true}},"texts":["{a}さんが持ち込みの結果を聞いて、帰りの電車で静かに座っていた。「次は読みたい」と言われたらしい","編集者から、{a}さんへのメールは「面白い、ただし全部直し」だった。直しの量は、最初の原稿の二倍だ"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":3}]},
  {"id":"wk-pachinko-luck","kind":"daily","trigger":"hour","cooldownDays":5,"when":{"hours":[17,23]},"roles":{"a":{"archetype":["pachinko"],"out":true}},"texts":["{a}さんが、パチンコ屋で偶然、新台の一番乗りになった。自慢は三分で終わり、あとはずっと静かだった","{a}さんは、パチンコの帰りに、自分の運のなさを街路樹に語っていた"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-2}]},
  {"id":"wk-pachinko-forecast","kind":"relation","trigger":"hour","cooldownDays":6,"roles":{"a":{"archetype":["pachinko"],"inRoom":true},"b":{"inRoom":true}},"texts":["{a}さんが、競馬新聞の予想を{b}さんに熱弁した。{b}さんは最初から最後まで、競馬に興味がない","{a}さんの予想は外れた。{b}さんには、「予想は当たっていた、馬が勘違いした」と説明した"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":3},{"type":"bond","delta":-1}]},
  {"id":"wk-student-class-absence","kind":"daily","trigger":"hour","cooldownDays":5,"when":{"hours":[8,14]},"roles":{"a":{"archetype":["student"],"inRoom":true}},"texts":["{a}さんは、三限の授業に出ようと思って、目覚まし時計を二回止めた。四限は始まる前に諦めた","{a}さんが、八年目の学生証を更新した。写真の顔が、入学時と別人になっている"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":-3}]},
  {"id":"wk-youtuber-views","kind":"daily","trigger":"hour","cooldownDays":5,"when":{"hours":[12,24]},"roles":{"a":{"archetype":["youtuber"],"inRoom":true}},"texts":["{a}さんの動画が、昨日より五人多く見られた。そのうち三人は、{a}さん本人だ","{a}さんが投稿した動画のコメント欄に、初めて見知らぬ人の名前があった。三回読み返した"],"effects":[{"type":"adjust","role":"a","stat":"mood","delta":6},{"type":"say","role":"a","text":"見てくれた…！"}]},
